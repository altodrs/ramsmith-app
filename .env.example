# Copy this file to .env.local for local development.
# In Vercel, set these under Project Settings -> Environment Variables instead
# (never commit real keys to git).

# Stripe secret key (server-only) — find it at dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_SECRET_KEY

# Stripe publishable key (safe for client) — same page as above
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_STRIPE_PUBLISHABLE_KEY

# Your site's own public URL, used to build Stripe's success/cancel redirect links.
# Locally this is http://localhost:3000. On Vercel, set it to your deployed URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (emails the PDF to customers) — sign up free at resend.com, key is
# under API Keys. Without this set, the site still works, it just won't email.
RESEND_API_KEY=REPLACE_WITH_YOUR_RESEND_API_KEY

# Optional. Defaults to Resend's shared test address (onboarding@resend.dev),
# which can only email your own Resend account address. Once ramsforge.co.uk
# is verified as a domain in Resend, set this to send from your own domain.
# RESEND_FROM=RAMS Forge <noreply@ramsforge.co.uk>

# Neon Postgres connection string — create a free project at neon.tech, copy
# the connection string from the dashboard. Use a separate one for Preview
# vs Production in Vercel so test data never touches production.
DATABASE_URL=REPLACE_WITH_YOUR_NEON_CONNECTION_STRING

# Auth.js session encryption secret — generate with `npx auth secret`.
AUTH_SECRET=REPLACE_WITH_YOUR_AUTH_SECRET

# Stripe webhook signing secret (Tier 2/3 fulfilment + subscription status
# sync) — Dashboard -> Developers -> Webhooks -> your endpoint -> Signing
# secret. Test mode and live mode each need their own endpoint + secret.
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET

# Stripe recurring Price IDs for the Tier 3 subscription (Dashboard ->
# Products -> create a product with a monthly and an annual price).
STRIPE_PRICE_MONTHLY=REPLACE_WITH_YOUR_STRIPE_MONTHLY_PRICE_ID
STRIPE_PRICE_ANNUAL=REPLACE_WITH_YOUR_STRIPE_ANNUAL_PRICE_ID
